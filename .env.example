# 默认只让这台电脑访问。需要手机通过局域网连接时，改成 0.0.0.0。
ALBUM_BIND_ADDRESS=127.0.0.1
ALBUM_PORT=8765
# HTTPS 反向代理的可信来源地址。容器部署时按实际代理地址填写，逗号分隔。
# 仅本机直接访问时保持默认；不要填写不受自己控制的代理。
ALBUM_TRUSTED_PROXIES=127.0.0.1
# 全新相册默认用 admin/admin 登录，首次登录必须改密；已有相册账号不重置。
# 如需使用专属设置口令创建管理员，可在第一次启动前取消下一行注释并填写至少八个字符。
# ALBUM_BOOTSTRAP_TOKEN=
# 每个文件最大两 GB；可按自己的服务器容量调整。
ALBUM_MAX_UPLOAD_BYTES=2147483648
# NAS 需要先挂载，再给容器添加对应目录映射。说明见 docs/部署与存储.md。
ALBUM_STORAGE_ROOTS=[]
# 网页后台可从服务器图库导入。增加其他目录时填写绝对路径列表，并给容器挂载同一目录。
ALBUM_IMPORT_ROOTS=[]
# 自建 S3 使用内网地址时，显式填写完整服务地址。多个地址用英文逗号隔开。
# 公有云的 HTTPS 地址通常无需填写。
ALBUM_STORAGE_ALLOWED_ENDPOINTS=
